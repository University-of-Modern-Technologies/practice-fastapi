# Shared by the Docker stack and by the backend run on this machine.
# Backend-only settings (secrets, limits, integrations) live in backend/.env.
PROJECT_NAME=practice-crm-python
APP_ENV=development

HTTP_PORT=8080
WEB_PORT=3000
API_PORT=8000
POSTGRES_PORT=5432
REDIS_PORT=6379
MONGO_PORT=27017
PORTAINER_PORT=9000

POSTGRES_DB=practice_crm
POSTGRES_USER=practice_crm
POSTGRES_PASSWORD=practice-local-password

MONGO_DB=practice_events
MONGO_USER=practice_crm
MONGO_PASSWORD=practice-local-password

# The network nginx reaches the API from: only a peer in it is believed about
# the client address. Docker allocates from this range unless configured otherwise.
# TRUSTED_PROXIES=172.16.0.0/12
