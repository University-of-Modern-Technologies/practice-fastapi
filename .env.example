APP_ENV=development
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3100
JSON_BODY_LIMIT_BYTES=1048576
POSTGRES_DB=practice_crm
POSTGRES_USER=practice_crm
POSTGRES_PASSWORD=change-me
DATABASE_URL=postgresql://practice_crm:change-me@localhost:5433/practice_crm
JWT_ACCESS_SECRET=change-me-to-at-least-32-characters
JWT_REFRESH_SECRET=change-me-to-at-least-32-characters
SEED_USER_PASSWORD=change-me
REDIS_URL=redis://localhost:6380
REDIS_KEY_PREFIX=crm:
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10
MONGO_DB=practice_events
MONGO_USER=practice_crm
MONGO_PASSWORD=change-me
MONGODB_URL=mongodb://practice_crm:change-me@localhost:27018/practice_events?authSource=admin
EVENT_LOG_RETENTION_DAYS=90
WS_PATH=/api/v1/realtime
# Delivery integration. Leave DELIVERY_BASE_URL empty to keep the built-in stub
# transport, which is what makes a fresh checkout work without a carrier account.
DELIVERY_BASE_URL=
DELIVERY_API_KEY=
DELIVERY_TIMEOUT_MS=5000
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BASE_BACKOFF_MS=100
DELIVERY_MAX_BACKOFF_MS=1000
DELIVERY_FAILURE_THRESHOLD=5
DELIVERY_COOLDOWN_MS=30000
DELIVERY_QUOTE_CACHE_TTL_SECONDS=60
# Assistant. Leave AI_ENDPOINT_URL empty to keep the offline mock provider,
# whose answers are templated and deterministic.
AI_ENDPOINT_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
AI_MAX_ATTEMPTS=2
AI_MAX_TOKENS=400
AI_MAX_INPUT_CHARS=4000
AI_CACHE_TTL_SECONDS=300
# INFRA_PROFILE selects a whole family of implementations at once instead of
# leaving each dependency to notice its own setting: `offline` forces the mock
# AI provider, the stub delivery transport and a cache with no external store,
# regardless of the settings above; `live` (or leaving this unset) is today's
# behaviour, where each dependency still decides for itself.
# INFRA_PROFILE=live
