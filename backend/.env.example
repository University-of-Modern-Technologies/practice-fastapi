# Backend-only settings. Ports, APP_ENV and the PostgreSQL / MongoDB names and
# credentials are shared and live in the repository root .env. DATABASE_URL,
# REDIS_URL and MONGODB_URL are assembled from those parts; set one here only
# to point the backend at a different server.
# A blank value (`KEY=`) means the same as a commented-out line: the default.
HOST=0.0.0.0
# PORT=8000
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT_BYTES=1048576
# Unset: /api/docs and /api/openapi.json are served everywhere except APP_ENV=production.
# API_DOCS_ENABLED=true
# Unset: there is no /api/metrics. At least 16 characters.
# METRICS_TOKEN=

JWT_ACCESS_SECRET=local-development-access-secret-not-for-real-use
JWT_REFRESH_SECRET=local-development-refresh-secret-not-for-real-use

SEED_USER_PASSWORD=practice-demo-password
# The production stack is a training stand: let the seed fill it on purpose.
SEED_ALLOW_PRODUCTION=true

REDIS_KEY_PREFIX=crm:
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

EVENT_LOG_RETENTION_DAYS=90
# Fixed: nginx and the web client connect to this same path.
WS_PATH=/api/v1/realtime

# Storage addresses. Normally left unset: assembled from the parts in ../.env,
# with the hosts below defaulting to 127.0.0.1 (the stack sets service names).
# DATABASE_URL=
# REDIS_URL=
# MONGODB_URL=
# POSTGRES_HOST=127.0.0.1
# REDIS_HOST=127.0.0.1
# MONGO_HOST=127.0.0.1

# Addresses or CIDR networks of reverse proxies whose X-Forwarded-For is
# believed. Unset: none is. The Docker stack sets it for nginx (see ../.env).
# TRUSTED_PROXIES=
# Log every SQL statement with its parameters. Never in production.
# LOG_SQL=false

SHUTDOWN_GRACE_PERIOD_MS=10000
SHUTDOWN_TIMEOUT_MS=15000

# Everything below is optional. Left unset, the AI provider is the offline
# mock, the delivery and telephony clients are the built-in stubs, and the
# cache is backed by Redis.
# DELIVERY_BASE_URL=
# DELIVERY_API_KEY=
# DELIVERY_TIMEOUT_MS=5000
# DELIVERY_MAX_ATTEMPTS=3
# DELIVERY_BASE_BACKOFF_MS=100
# DELIVERY_MAX_BACKOFF_MS=1000
# DELIVERY_FAILURE_THRESHOLD=5
# DELIVERY_COOLDOWN_MS=30000
# DELIVERY_QUOTE_CACHE_TTL_SECONDS=60
# AI_ENDPOINT_URL=
# AI_API_KEY=
# AI_MODEL=
# AI_TIMEOUT_MS=10000
# AI_MAX_ATTEMPTS=2
# AI_MAX_TOKENS=400
# AI_MAX_INPUT_CHARS=4000
# AI_CACHE_TTL_SECONDS=300
# CALL_PROVIDER_BASE_URL=
# CALL_PROVIDER_API_KEY=
# CALL_PROVIDER_TIMEOUT_MS=5000
# CALL_PROVIDER_MAX_ATTEMPTS=3
# CALL_PROVIDER_BACKOFF_MS=200
# CALL_SYNC_BATCH_SIZE=100

# `offline` forces every stand-in at once: mock AI, stub delivery, no cache store.
# INFRA_PROFILE=live
