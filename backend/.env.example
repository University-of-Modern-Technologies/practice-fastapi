# Backend-only settings. Ports, APP_ENV and the PostgreSQL / MongoDB names and
# credentials are shared and live in the repository root .env. DATABASE_URL,
# REDIS_URL and MONGODB_URL are assembled from those parts; set one here only
# to point the backend at a different server.
HOST=0.0.0.0
LOG_LEVEL=info
CORS_ORIGINS=http://localhost:3000
JSON_BODY_LIMIT_BYTES=1048576

JWT_ACCESS_SECRET=local-development-access-secret-not-for-real-use
JWT_REFRESH_SECRET=local-development-refresh-secret-not-for-real-use

SEED_USER_PASSWORD=practice-demo-password
# The production stack is a training stand: let the seed fill it on purpose.
SEED_ALLOW_PRODUCTION=true

REDIS_KEY_PREFIX=crm:
CACHE_TTL_SECONDS=300
RATE_LIMIT_WINDOW_SECONDS=60
RATE_LIMIT_MAX_REQUESTS=300
AUTH_RATE_LIMIT_MAX_REQUESTS=10

EVENT_LOG_RETENTION_DAYS=90
WS_PATH=/api/v1/realtime

SHUTDOWN_GRACE_PERIOD_MS=10000
SHUTDOWN_TIMEOUT_MS=15000

# Empty DELIVERY_BASE_URL keeps the built-in stub transport.
DELIVERY_BASE_URL=
DELIVERY_API_KEY=
DELIVERY_TIMEOUT_MS=5000
DELIVERY_MAX_ATTEMPTS=3
DELIVERY_BASE_BACKOFF_MS=100
DELIVERY_MAX_BACKOFF_MS=1000
DELIVERY_FAILURE_THRESHOLD=5
DELIVERY_COOLDOWN_MS=30000
DELIVERY_QUOTE_CACHE_TTL_SECONDS=60

# Empty AI_ENDPOINT_URL keeps the offline mock provider.
AI_ENDPOINT_URL=
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_MS=10000
AI_MAX_ATTEMPTS=2
AI_MAX_TOKENS=400
AI_MAX_INPUT_CHARS=4000
AI_CACHE_TTL_SECONDS=300

# `offline` forces every stand-in at once: mock AI, stub delivery, no cache store.
# INFRA_PROFILE=live
